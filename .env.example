# ─── Database (Phase 2 — Neon PostgreSQL + Drizzle) ──────────────────────────
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ─── Auth (Phase 2 — Better Auth) ────────────────────────────────────────────
