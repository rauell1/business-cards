{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "business-cards",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Runtime secrets are set with `npx wrangler secret put NAME` or in the Cloudflare dashboard.
  "keep_vars": true,
  "workers_dev": true,
  "observability": { "enabled": true },
  // Page cache for open-next.config.ts.
  "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV", "id": "31cba4921b8d4c69a879b68cc8579a46" }]
}
